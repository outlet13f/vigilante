// Jenkins declarative pipeline: vigilante gates each rollout phase.
// Exit codes: 0 promote | 2 rolled back | 3 rollback failed / circuit open | 4 held
//
// vigilante fills its own inputs here: the deployment ID from BUILD_TAG, the
// version from GIT_COMMIT, and --previous from the last successful deployment
// in its journal. Before the first run, register the version in production once:
//   vigilante mark-good -c /etc/vigilante/vigilante.yaml --service order-api --version <current>
pipeline {
  agent any
  environment {
    SVC = 'order-api'
    NEW = "${env.GIT_COMMIT.take(8)}"   // only for the deploy tool; vigilante derives it itself
    VIG = 'vigilante -c /etc/vigilante/vigilante.yaml'
  }
  stages {
    stage('Validate rollback config') { steps { sh "${VIG} validate" } }
    stage('Checkpoint + baseline') {
      steps {
        sh "${VIG} prepare  --service ${SVC}"
        sh "${VIG} baseline --service ${SVC} --window 5m --out baseline.json"
      }
    }
    stage('Canary') {
      steps {
        sh "ansible-playbook deploy.yml -l order-bm-01 -e version=${NEW}"
        script { gate('canary') }
      }
    }
    stage('Rolling') {
      steps {
        sh "ansible-playbook deploy.yml -l order-bm-02 -e version=${NEW}"
        script { gate('rolling') }
      }
    }
    stage('Full') {
      steps {
        sh "ansible-playbook deploy.yml -e version=${NEW}"
        // A passing full phase records this version as the next run's --previous.
        script { gate('full') }
      }
    }
  }
}

def gate(String phase) {
  def rc = sh(returnStatus: true, script:
    "${VIG} watch --service ${SVC} --phase ${phase} --baseline baseline.json")
  switch (rc) {
    case 0: echo "${phase}: PASS"; break
    case 2: error("${phase}: FAILED — vigilante rolled back to the last known-good version")
    case 3: error("${phase}: ROLLBACK FAILED or circuit OPEN — page on-call")
    case 4: input message: "${phase} is HELD (environmental / inconclusive). Promote anyway?"; break
    default: error("vigilante error (${rc})")
  }
}
